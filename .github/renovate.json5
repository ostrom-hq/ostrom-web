{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Inspired by astral-sh/uv, biomejs/biome and PostHog: pinned digests, a release age floor, grouped minor updates.
  extends: ['config:best-practices', ':semanticCommits', 'schedule:weekly'],
  timezone: 'Europe/Paris',
  labels: ['dependencies'],
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  // A new release waits three days before we take it: most compromised packages are pulled within hours.
  minimumReleaseAge: '3 days',
  lockFileMaintenance: { enabled: true, schedule: ['before 6am on monday'] },
  packageRules: [
    {
      description: 'GitHub Actions: pinned by commit, one pull request',
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      pinDigests: true,
    },
    {
      description: 'Minor and patch updates: one pull request per week',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      matchManagers: ['!github-actions'],
      groupName: 'non-major dependencies',
    },
  ],
  vulnerabilityAlerts: { labels: ['security'], minimumReleaseAge: null, schedule: ['at any time'] },
}
