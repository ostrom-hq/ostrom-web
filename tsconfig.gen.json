{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/gen",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.gen.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // Generated code (hey-api's bundled fetch client) does not satisfy this one flag. It is compiled as its own
    // project and the console only sees its declarations; every other strict flag still applies to it.
    "exactOptionalPropertyTypes": false
  },
  "include": ["gen"]
}
