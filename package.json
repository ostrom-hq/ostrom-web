    "@tanstack/react-router": "1.170.46",
    "i18next": "26.5.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
