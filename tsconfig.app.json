{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./src/*"],
      "@ee/*": ["./ee/*"],
      "@gen/*": ["./gen/*"]
    }
  },
  "include": ["src", "ee"],
  "references": [
    {
      "path": "./tsconfig.gen.json"
    }
  ]
}
