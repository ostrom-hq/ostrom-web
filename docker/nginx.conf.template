# Rendered at start by the image's envsubst step (only ${OSTROM_*} variables).

# WebSocket upgrade for the terminal routes; plain keep-alive otherwise.
map $http_upgrade $ostrom_connection {
    default upgrade;
    ''      '';
}

# $ostrom_csp_connect_extra: the PostHog origin the CSP's connect-src allows, or nothing (40-ostrom-config.sh).
include /var/run/ostrom/csp.conf;

# $ostrom_from_trusted_proxy: 1 when the client is a proxy of OSTROM_TRUSTED_PROXIES (40-ostrom-config.sh). Only such a
# proxy says which scheme the browser used, and only http or https; any other client gets nginx's own (audit B5).
include /var/run/ostrom/proxies.conf;
map "$ostrom_from_trusted_proxy:$http_x_forwarded_proto" $ostrom_forwarded_proto {
    default  $scheme;
    "1:https" https;
    "1:http"  http;
}

# The access log keeps the path, never the query string nor a Referer's (web audit 2, W4): a device code (`/device?code=`,
# `GET /api/v1/auth/device?userCode=`) or a terminal ticket (`?ticket=`) never lands in it. nginx's error log still
# names the whole request when the server cannot be reached: it has no format to change.
map $request_uri $ostrom_log_path {
    ~^([^?]*) $1;
}
map $http_referer $ostrom_log_referer {
    ~^([^?#]*) $1;
}
log_format ostrom_noquery '$remote_addr - $remote_user [$time_local] "$request_method $ostrom_log_path $server_protocol" '
                          '$status $body_bytes_sent "$ostrom_log_referer" "$http_user_agent"';

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log ostrom_noquery;

    include /etc/nginx/ostrom/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime settings (public values only), written at start by 40-ostrom-config.sh.
    location = /config.js {
        alias /var/run/ostrom/config.js;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/ostrom/security-headers.conf;
    }

    # The API on the same origin: the contract's paths start with /api/v1, passed unchanged to the server.
    # Streaming kept (SSE), WebSocket upgrades passed through (cloud session terminals).
    location /api/ {
        proxy_pass ${OSTROM_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ostrom_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ostrom_connection;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 16m;
    }

    # Hashed assets: cached for a year, sent compressed to a browser that accepts it (the .gz written at build).
    location /assets/ {
        gzip_static on;
        gzip_vary on;
        # Behind an ingress or a CDN too (a request with `Via`): the default would send them whole there.
        gzip_proxied any;
        # And from a proxy that speaks HTTP/1.0 to the pod (the default answers it whole).
        gzip_http_version 1.0;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/ostrom/security-headers.conf;
        try_files $uri =404;
    }

    # The single-page app: every other path serves index.html, never cached.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/ostrom/security-headers.conf;
        try_files $uri /index.html;
    }
}
